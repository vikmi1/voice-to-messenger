# Скопируй в .env и заполни. Файл .env в git не попадает.

# Логин/пароль для входа в админ-панель (/admin)
ADMIN_USER=admin
ADMIN_PASS=changeme

# Секрет Flask-сессии (любая длинная случайная строка)
SECRET_KEY=change-me-to-a-long-random-string

# Путь к файлу базы (необязательно; по умолчанию config.sqlite3 рядом с app.py)
# DB_PATH=config.sqlite3
