# Секреты прод-бэкенда. На сервере лежит как /opt/voiceapp/.env.docker (chmod 600),
# в git НЕ попадает. Скопируй в .env.docker и заполни.

ADMIN_USER=admin
ADMIN_PASS=            # надёжный пароль для входа в /admin
SECRET_KEY=           # длинная случайная строка (напр. `openssl rand -hex 32`)
DB_PATH=/app/data/config.sqlite3

# Ключи провайдеров (если не заданы в панели — берутся отсюда по <ПРОВАЙДЕР>_API_KEY).
MISTRAL_API_KEY=
# OPENAI_API_KEY=
